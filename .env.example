# Copy to .env (never commit it) and fill in. Every value can alternatively live in secrets.json;
# environment variables take precedence. See README "Configuration".

# ClickHouse (data database)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=living_liquid_mv
CLICKHOUSE_SECURE=true

# FireAI login service
FIREAI_BASE_URL=
FIREAI_API_KEY=

# Comma-separated e-mails allowed to log in
ALLOWED_EMAILS=

# Random 64-hex-char string, unique per environment. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=

# Optional: login session length in hours (default 1)
SESSION_HOURS=1
