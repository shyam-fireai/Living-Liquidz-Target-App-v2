# Streamlit secrets (TOML). Two ways to use this file:
#   - Streamlit Community Cloud: paste the contents into App settings -> Secrets.
#   - Locally (optional): copy to .streamlit/secrets.toml. Never commit that file (it is gitignored).
# Values here win over environment variables and secrets.json. See README "Configuration".

# ClickHouse (data database). Must be reachable from the internet for Streamlit Cloud.
CLICKHOUSE_HOST = "your-clickhouse-host.example.com"
CLICKHOUSE_PORT = 8443
CLICKHOUSE_USER = "app_user"
CLICKHOUSE_PASSWORD = "change-me"
CLICKHOUSE_DATABASE = "living_liquid_mv"
CLICKHOUSE_SECURE = true

# FireAI login service
FIREAI_BASE_URL = "https://fireai-auth.example.com"
FIREAI_API_KEY = "change-me"

# Who may log in: a TOML list (or one comma-separated string)
ALLOWED_EMAILS = ["user1@company.com", "user2@company.com"]

# At least 32 random characters, unique per environment. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET = "paste-a-new-64-character-hex-string-here"

# Optional: login session length in hours (default 1)
SESSION_HOURS = 1
